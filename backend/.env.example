# Copy this file to backend/.env and add your own local values.
# Do not commit backend/.env or expose API keys in frontend/VITE variables.
PORT=5000
JWT_SECRET=replace-with-a-long-random-local-secret
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/campuslink

# Create a key at https://aistudio.google.com/app/apikey
# Used by the backend Gemini service; keep this key server-side only.
GEMINI_API_KEY=your_gemini_api_key_here
