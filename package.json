{"name":"campuslink","private":true,"version":"1.0.0","type":"module","scripts":{"dev":"concurrently \"npm:dev:backend\" \"npm:dev:student\" \"npm:dev:recruiter\" \"npm:dev:tpo\"","dev:backend":"tsx backend/server.ts","dev:student":"vite --config frontend-student/vite.config.ts --port 3001","dev:recruiter":"vite --config frontend-recruiter/vite.config.ts --port 3002","dev:tpo":"vite --config frontend-tpo/vite.config.ts --port 3003","build":"npm run build:student && npm run build:recruiter && npm run build:tpo","build:student":"vite build --config frontend-student/vite.config.ts","build:recruiter":"vite build --config frontend-recruiter/vite.config.ts","build:tpo":"vite build --config frontend-tpo/vite.config.ts"},"devDependencies":{"concurrently":"^9.2.1","tsx":"^4.21.0","vite":"^8.3.0"}}